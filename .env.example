# ==============================================================================
# LAN PRINTER MANAGER - ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env and fill in the appropriate environment values.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
APP_NAME="LAN Printer Manager"
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# PostgreSQL Database Configuration (Psycopg 3)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=lan_printer_manager
DB_USER=lan_manager_app
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_CONNECT_TIMEOUT=5
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Optional Separate Test Database for Integration Tests
TEST_DATABASE_URL=postgresql+psycopg://lan_manager_app:CHANGE_ME_STRONG_DB_PASSWORD@127.0.0.1:5432/lan_printer_manager_test

# Initial Admin Bootstrap (Used only by scripts/init_db.py when DB has no users)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHANGE_ME_BEFORE_INIT

# Controlled LAN Discovery Settings
# Comma-separated list of CIDR subnets authorized for scanning by the administrator
ALLOWED_SCAN_SUBNETS=192.168.1.0/24,192.168.10.0/24,10.0.0.0/24
MAX_SCAN_HOSTS=1024
MAX_CONCURRENT_PROBES=32
SCAN_RATE_LIMIT_PER_SEC=64
TCP_PROBE_TIMEOUT_SEC=1.5
ICMP_TIMEOUT_MS=1000

# SNMP Read-Only Configuration
SNMP_ENABLED_BY_DEFAULT=true
SNMP_COMMUNITY=public
SNMP_PORT=161
SNMP_TIMEOUT_SEC=1.5
SNMP_RETRIES=1

# Remote Agent Execution Security
REMOTE_AGENT_PORT=8443
REMOTE_AGENT_TIMEOUT_SEC=10.0
REMOTE_AGENT_SHARED_SECRET=CHANGE_ME_RANDOM_32_BYTE_HEX_SECRET
REMOTE_AGENT_VERIFY_TLS=true

